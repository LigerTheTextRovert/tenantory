# ============================================
# Tenantory — Production Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Application ---
NODE_ENV=production
APP_PORT=3000

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_PORT_EXTERNAL=5432
DB_USERNAME=tenantory_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=tenantory_prod_db

# --- JWT Secrets (generate long random strings!) ---
JWT_ACCESS_SECRET=CHANGE_ME_random_string_at_least_32_chars_access
JWT_REFRESH_SECRET=CHANGE_ME_random_string_at_least_32_chars_refresh

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=tenantory_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_NAME=tenantory
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- pgAdmin (optional) ---
PG_EMAIL=admin@tenantory.local
PG_PASS=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050
