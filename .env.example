# Application
NODE_ENV=development
APP_PORT=3000

# PostgreSQL (used by docker compose and the app)
DB_HOST=localhost
DB_PORT=5432
DB_PORT_EXTERNAL=5432
DB_USERNAME=tenantory_user
DB_PASSWORD=tenantory_pass
DB_DATABASE=tenantory_db
DB_SYNCHRONIZE=false

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=tenantory

# pgAdmin (docker compose only)
PG_EMAIL=admin@example.com
PG_PASS=pgadmin_pass
