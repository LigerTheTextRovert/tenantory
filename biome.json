{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/node_modules",
			"!!**/coverage",
			"!!**/reference",
			"!!**/learning-records",
			"!!**/lessons",
			"!!**/docs"
		]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf"
	},

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",

			"correctness": {
				"noUnusedFunctionParameters": "off"
			},

			"suspicious": {
				"noExplicitAny": "warn"
			}
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		},

		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
